# Supabase Postgres — Transaction pooler connection (port 6543), used by the running app.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Supabase Postgres — Direct connection (port 5432), used only for migrations and the seed script.
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Code required to create an account. Share it with the people you want in;
# rotate it by changing this value. Without it, signup is closed.
INVITE_CODE="change-me"

# Random 32+ byte secret used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me"
